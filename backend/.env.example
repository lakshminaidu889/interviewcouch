# Leave DATABASE_URL as-is to use SQLite locally, or point it at PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/interview
DATABASE_URL=sqlite:///./interview.db
SECRET_KEY=change-me-to-a-long-random-string
# Free key from https://console.groq.com  (empty = built-in demo feedback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:5173
